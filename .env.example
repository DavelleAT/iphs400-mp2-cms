# Copy to .env (which is gitignored) and change the values.
# development or production; production refuses these example values (README, Production).
CMS_ENV=development
CMS_SECRET_KEY=change-me-to-a-long-random-string
CMS_SITE_TITLE=Kenyon Office of Institutional Research
CMS_DATABASE=cms.db
CMS_UPLOADS=uploads
# Demo accounts created by scripts/seed_demo.py
CMS_ADMIN_PASSWORD=change-me-admin
CMS_EDITOR_PASSWORD=change-me-editor
# Production only: the one Director created at first start (with CMS_ADMIN_PASSWORD).
CMS_ADMIN_EMAIL=
# Set after you deploy, e.g. https://yourname.github.io/iphs400-mp2-cms/
CMS_BASE_PATH=
